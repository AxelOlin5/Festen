<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/USS/choiceButton.uss?fileID=7433441132597879392&amp;guid=e77294e99975f9049a28e37891305128&amp;type=3#choiceButton"/>
    <ui:VisualElement name="TextBox" style="flex-grow: 0; background-color: rgba(36, 36, 36, 0.659); flex-basis: 100%; flex-shrink: 0; position: absolute; bottom: 10%; left: 13%; right: 50%; align-items: flex-start; justify-content: flex-start; align-self: center; align-content: center; width: 75%; height: 20%; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(217, 217, 217); border-right-color: rgb(217, 217, 217); border-top-color: rgb(217, 217, 217); border-bottom-color: rgb(217, 217, 217); visibility: visible; display: flex;">
        <ui:VisualElement name="SpeakerName" style="flex-grow: 0; top: -24%; width: 20%; height: 11%; flex-shrink: 0; flex-basis: 100%; background-color: rgb(0, 0, 0); right: 3%; bottom: 0%; min-height: 0%; max-height: 54%;">
            <ui:Label text="Speaker" name="SpeakerNameText" style="flex-grow: 1; color: rgb(255, 255, 255); font-size: 35px; -unity-font-style: bold; -unity-text-align: upper-center;"/>
        </ui:VisualElement>
        <ui:Label text="Dialogue Text Here" name="TextBoxText" style="position: absolute; right: 3%; top: 12%; flex-wrap: wrap; align-self: flex-start; font-size: 30%; color: rgb(255, 255, 255); -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 0.05px; height: 68%; width: 77%; align-content: center; white-space: normal;"/>
    </ui:VisualElement>
    <ui:VisualElement name="ChoiceContainer" style="flex-grow: 0; flex-shrink: 0; align-self: center; align-content: center; justify-content: center; align-items: center; width: 60%; height: 50%; top: 10%;"/>
</ui:UXML>
