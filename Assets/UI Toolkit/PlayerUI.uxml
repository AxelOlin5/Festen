<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="TextBox" style="flex-grow: 0; background-color: rgba(36, 36, 36, 0.686); flex-basis: 100%; flex-shrink: 0; position: absolute; bottom: 10%; left: 13%; right: 50%; align-items: flex-start; justify-content: flex-start; align-self: center; align-content: center; width: 75%; height: 20%; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(217, 217, 217); border-right-color: rgb(217, 217, 217); border-top-color: rgb(217, 217, 217); border-bottom-color: rgb(217, 217, 217); visibility: visible; display: none;">
        <ui:VisualElement name="SpeakerName" style="flex-grow: 0; top: -24%; width: 20%; height: 11%; flex-shrink: 0; flex-basis: 100%; background-color: rgb(0, 0, 0); right: 3%; bottom: 0%; min-height: 0%; max-height: 54%; border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);">
            <ui:Label text="Jonas" name="SpeakerNametext" style="flex-grow: 1; color: rgb(255, 255, 255); font-size: 35px; -unity-font-style: bold; -unity-text-align: upper-center;"/>
        </ui:VisualElement>
        <ui:Label text="Label" name="TextBoxText"/>
    </ui:VisualElement>
</ui:UXML>
